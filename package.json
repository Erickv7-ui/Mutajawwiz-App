{
  "name": "absensi-web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "build:static": "node scripts/build-static.js",
    "dev": "node server.js",
    "cf:dev": "node scripts/build-static.js && wrangler pages dev dist --d1=DB",
    "cf:deploy": "node scripts/build-static.js && wrangler pages deploy dist",
    "db:init": "wrangler d1 execute mutajawwiz --remote --file=db/schema.sql",
    "db:migrate": "node scripts/migrate-to-d1.js"
  },
  "dependencies": {
    "@vercel/blob": "^2.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.163.0"
  }
}
