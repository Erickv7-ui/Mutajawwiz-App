{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api", "run": { "serviceId": "mutajawwiz-api", "region": "asia-southeast2" } },
      { "source": "/api/**", "run": { "serviceId": "mutajawwiz-api", "region": "asia-southeast2" } }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-store" }]
      }
    ]
  }
}
